{
  "name": "@norte/web",
  "version": "0.1.0",
  "private": true,
  "description": "Interfaz de NORTE: búsqueda, encaje, brecha, postulaciones y observatorio sobre el índice estático.",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/prepare-assets.mjs --with-data",
    "start": "ng serve",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "node scripts/prepare-assets.mjs",
    "test": "ng test --watch=false",
    "e2e": "playwright test",
    "e2e:pages": "playwright test -c playwright.pages.config.ts"
  },
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@angular/service-worker": "22.2.4",
    "@norte/core": "0.1.0",
    "minisearch": "7.2.0",
    "pdfjs-dist": "6.4.299",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@playwright/test": "1.64.1",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
