{
  "$schema": "../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": { "files": ["/favicon.svg", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"] }
    },
    {
      "name": "lazy",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": { "files": ["/assets/**", "/chunk-*.js"] }
    }
  ],
  "dataGroups": [
    {
      "name": "indice",
      "urls": ["/data/v1/**", "/config.json"],
      "cacheConfig": { "strategy": "freshness", "maxSize": 40, "maxAge": "7d", "timeout": "4s" }
    }
  ]
}
