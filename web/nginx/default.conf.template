# Plantilla procesada por envsubst al arrancar (imagen oficial de nginx): solo se sustituye ${NORTE_API_URL}.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    gzip on;
    gzip_types application/json application/javascript text/css text/csv image/svg+xml application/manifest+json;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.github.com ${NORTE_API_URL}; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;

    # Configuración de ejecución: la URL de la API viene del entorno, nunca del código.
    location = /config.json {
        default_type application/json;
        expires -1;
        return 200 '{"apiBaseUrl":"${NORTE_API_URL}","pollMinutes":5,"newJobsThreshold":10}';
    }

    # El índice cambia en cada ingesta: se revalida siempre.
    location /data/ {
        expires -1;
        try_files $uri =404;
    }

    location ~* \.(?:js|mjs|css|woff2?)$ {
        expires 1y;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
