# Copia este archivo a .env y completa los valores. .env NUNCA se sube a GitHub.
# Las variables marcadas como obligatorias no tienen valor por defecto: sin ellas la API no arranca.

# ---- Base de datos (obligatorias)
DB_URL=jdbc:postgresql://localhost:5432/norte
DB_USER=norte
DB_PASSWORD=

# ---- Seguridad (obligatorias)
# Secreto HS256 de al menos 32 bytes aleatorios en Base64: openssl rand -base64 48
JWT_SECRET=
# Secreto compartido con GitHub Actions para disparar las alertas: openssl rand -hex 32
ALERTS_TRIGGER_TOKEN=
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8081

# ---- Índice estático publicado por la ingesta (lo lee la API para las alertas)
NORTE_INDEX_BASE_URL=http://web:8080/data/v1
# Dirección pública del sitio (enlaces de los correos de alerta)
NORTE_SITE_URL=http://localhost:8081

# ---- Correo de alertas (SMTP). En local, Mailpit no necesita usuario ni clave.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
ALERTS_FROM=alertas@norte.local

# ---- Web (contenedor nginx): URL pública de la API que usará el navegador
NORTE_API_URL=http://localhost:8080

# ---- Opcional
APP_PORT=8080
OPENAPI_ENABLED=true
# Cabecera con la IP real del visitante, solo si un proxy de confianza la sobrescribe siempre. En Render: CF-Connecting-IP (ver docs/investigacion.md, S-10).
CLIENT_IP_HEADER=
